# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get these from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-secret-key-here

# Webhook secret (get after setting up webhook endpoint)
# https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ============================================
# RESEND (EMAIL) CONFIGURATION
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here

# Optional: Resend Audience ID for newsletter segmentation
# Get from: https://resend.com/audiences
RESEND_AUDIENCE_ID=

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Email address for the first admin user
ADMIN_EMAIL=your-email@example.com

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Base URL of your application (for emails, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
